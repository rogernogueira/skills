{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entrada de catálogo",
  "type": "object",
  "required": [
    "id",
    "nome",
    "classe"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cmp-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nome": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "classe": {
      "type": "string",
      "enum": [
        "servidor",
        "docker",
        "rede",
        "servico",
        "api",
        "fila",
        "modelo",
        "armazenamento"
      ]
    }
  }
}
