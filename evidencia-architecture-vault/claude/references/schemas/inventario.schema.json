{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recorte de arquitetura do EvidencIA",
  "type": "object",
  "required": [
    "versao",
    "ambiente",
    "plano",
    "natureza",
    "componentes",
    "afirmacoes",
    "evidencias"
  ],
  "additionalProperties": false,
  "properties": {
    "contexto_infra": {
      "type": "string",
      "enum": ["desenvolvimento-local", "producao-remota"]
    },
    "pendencias": {
      "type": "array", "minItems": 0,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item", "motivo", "pergunta"],
        "properties": {
          "item": {"type": "string", "pattern": "\\S"},
          "motivo": {"type": "string", "pattern": "\\S"},
          "pergunta": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "versao": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "ambiente": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "plano": {
      "type": "string",
      "enum": [
        "documentado",
        "configurado",
        "observado"
      ]
    },
    "natureza": {
      "type": "string",
      "enum": [
        "documental",
        "operacional",
        "simulada"
      ]
    },
    "componentes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "componente.schema.json"
      }
    },
    "afirmacoes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "afirmacao.schema.json"
      }
    },
    "evidencias": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "evidencia.schema.json"
      }
    }
  }
}
